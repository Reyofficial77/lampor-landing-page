# Neon PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/lampor?sslmode=require

# 64-char random hex secret for HMAC-SHA256 PoW challenges & token signing
AUTH_SECRET=replace-with-a-long-random-hex-secret-in-production

# Initial administrator account bootstrapped when no admin user exists yet
ADMIN_USERNAME=admin_lampor
ADMIN_PASSWORD=ChangeThisAdminPass123

# Optional comma-separated extra allowed origins for credentialed Admin requests
ALLOWED_ORIGINS=https://lampor.vercel.app

# Local API dev port (used by npm run dev:api)
API_PORT=3001

# Set to "memory" for local/test execution without Neon PostgreSQL
# LAMPOR_TEST_DB=memory
